{
  "name": "ynot-license-admin",
  "version": "1.0.1",
  "private": true,
  "description": "Separate offline license issuer for YNOT administrators",
  "author": "YNOT Photography",
  "main": "main.cjs",
  "build": {
    "appId": "com.ynotphotography.licenseadmin",
    "productName": "YNOT License Admin",
    "electronVersion": "31.7.7",
    "files": [
      "main.cjs",
      "device-license.cjs",
      "preload.cjs",
      "issuer.cjs",
      "renderer.js",
      "index.html",
      "public-key.json",
      "history.cjs",
      "backup.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../build/icon.ico"
    },
    "portable": {
      "artifactName": "YNOT License Admin.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "../build/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "YNOT-License-Admin-${version}-${arch}.${ext}"
    }
  }
}
