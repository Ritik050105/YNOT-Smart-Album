{
  "name": "ynot-album-studio",
  "private": true,
  "version": "0.1.4",
  "description": "Internal album design studio built for YNOT Photography",
  "main": "dist-electron/main.js",
  "author": "YNOT Photography",
  "build": {
    "appId": "com.ynotphotography.albumstudio",
    "productName": "YNOT Album Studio",
    "copyright": "Copyright (c) YNOT Photography",
    "files": [
      "dist/**",
      "dist-electron/**",
      "src/assets/ynot-mark-dark.png",
      "build/icon.ico"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "ynot-app.ico"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "icon": "node scripts/generate-icon.mjs",
    "build:renderer": "tsc -b && vite build",
    "build:main": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder -mwl",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "dist:admin": "npm run build:main && node scripts/build-license-admin.cjs"
  },
  "dependencies": {
    "ag-psd": "^31.0.0",
    "exifr": "^7.1.3",
    "konva": "^9.3.14",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "sharp": "^0.35.5",
    "use-image": "^1.1.1",
    "uuid": "^9.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
